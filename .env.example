AGENT_DATABASE_URL=sqlite:///./data/agent.db

# LLM provider — auto-detected from whichever key is set below.
# Override explicitly: anthropic | gemini
# AGENT_LLM_PROVIDER=anthropic

# Override model (uses provider default when blank):
# AGENT_LLM_MODEL=claude-sonnet-4-6   (Anthropic default)
# AGENT_LLM_MODEL=gemini-3.1-pro       (Gemini default)

# Set exactly ONE provider key:
AGENT_ANTHROPIC_API_KEY=
AGENT_GEMINI_API_KEY=

PORT=8001

# --- JAR Security Scanner: decompiler + scan tuning (jar-security-scanner) ---
# Local JVM tool used to decompile uploaded JARs (never leaves the machine).
AGENT_CFR_JAR_PATH=tools/cfr-0.152.jar
AGENT_JAVA_BIN=java
AGENT_CFR_TIMEOUT_S=180

# Local working directories for uploads and decompiled output (gitignored via data/).
AGENT_SCAN_UPLOAD_DIR=data/uploads
AGENT_SCAN_WORK_DIR=data/decompiled

# Triage / cost-control caps for what reaches the LLM per scan.
AGENT_TRIAGE_MAX_CLASSES=60
AGENT_TRIAGE_MAX_CHARS=150000
AGENT_TRIAGE_PER_CATEGORY_MAX_CHARS=30000
AGENT_MAX_UPLOAD_MB=200

# Version tag for the hardcoded Anthropic pricing table (src/llm/pricing.py) —
# bump when pricing is re-verified against current Anthropic docs.
AGENT_PRICING_TABLE_VERSION=2026-07

# Optional: LangSmith tracing (not AGENT_-prefixed; read directly by the LangChain/
# LangGraph SDKs). Leave blank to disable tracing.
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=jar-security-scanner
